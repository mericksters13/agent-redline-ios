      "html": "<div class=\"ds-action-bed\"><button class=\"ds-primary\">Add note</button></div>",
      "css": ".ds-action-bed{padding:16px;background:#000;border-radius:24px}.ds-primary{font:600 15px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;color:#000;background:#fff;border:0;border-radius:999px;min-height:44px;padding:8px 18px;cursor:pointer}.ds-primary:hover{background:#eee}.ds-primary:focus-visible{outline:2px solid #fff;outline-offset:4px}.ds-primary:active{opacity:.8}"
