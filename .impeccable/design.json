      "html": "<nav class=\"ds-island\" aria-label=\"Example annotation controls\"><button class=\"ds-island-close\" aria-label=\"Close annotate mode\"><svg viewBox=\"0 0 20 20\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M5 5l10 10M15 5L5 15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg></button><div class=\"ds-island-context\"><strong>Screen</strong><span>1 note</span></div><button class=\"ds-island-send\">Send</button></nav>",
      "css": ".ds-island{display:flex;align-items:center;gap:4px;padding:4px 9px 4px 4px;background:#000;color:#fff;border:1px solid rgb(255 255 255 / .16);border-radius:999px;box-shadow:0 6px 14px rgb(0 0 0 / .3);font-family:-apple-system,BlinkMacSystemFont,system-ui,sans-serif}.ds-island-close{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;color:#fff;background:rgb(255 255 255 / .12);border:0;border-radius:50%;cursor:pointer}.ds-island-context{flex:1;min-width:0;padding:0 4px}.ds-island-context strong{display:block;font-size:15px;font-weight:600}.ds-island-context span{display:block;color:rgb(255 255 255 / .6);font-size:12px}.ds-island-send{min-height:44px;padding:6px 12px;color:#000;background:#fff;border:0;border-radius:999px;font:600 15px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;cursor:pointer}.ds-island-close:hover{background:rgb(255 255 255 / .2)}.ds-island-send:hover{background:#eee}.ds-island-close:focus-visible,.ds-island-send:focus-visible{outline:2px solid #fff;outline-offset:2px}.ds-island-close:active,.ds-island-send:active{opacity:.8}"
