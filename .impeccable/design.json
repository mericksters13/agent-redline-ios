      "html": "<section class=\"ds-padding-bed\" aria-label=\"Illustrative padding measurements\"><button class=\"ds-measure ds-measure-vertical\" aria-pressed=\"false\" aria-label=\"Top padding, 0 points\"><span><svg class=\"ds-dimension-line ds-dimension-vertical\" viewBox=\"0 0 16 44\" width=\"16\" height=\"44\" aria-hidden=\"true\"><path class=\"ds-dimension-stroke\" d=\"M8 2V42M2 2H14M2 42H14\" fill=\"none\" stroke=\"currentColor\"/></svg></span><span class=\"ds-measure-label\">Top<strong class=\"ds-measure-value\">0 pt</strong></span></button><div class=\"ds-measure-row\"><button class=\"ds-measure ds-measure-horizontal ds-measure-selected\" aria-pressed=\"true\" aria-label=\"Left padding, 16 points\"><span>Left</span><span class=\"ds-horizontal-span\"><svg class=\"ds-dimension-line ds-dimension-horizontal\" viewBox=\"0 0 62 24\" width=\"62\" height=\"24\" aria-hidden=\"true\"><path class=\"ds-dimension-stroke\" d=\"M2 12H60M2 6V18M60 6V18\" fill=\"none\" stroke=\"currentColor\"/></svg><strong class=\"ds-measure-value\">16 pt</strong></span></button><div class=\"ds-capture-bed\"><div class=\"ds-capture-crop\" aria-label=\"Illustrative captured component and padding\"><span class=\"ds-capture-padding ds-capture-selected\"></span><span class=\"ds-content-outline\">Sample</span><span class=\"ds-capture-padding\"></span></div></div><button class=\"ds-measure ds-measure-horizontal\" aria-pressed=\"false\" aria-label=\"Right padding, 16 points\"><span>Right</span><span class=\"ds-horizontal-span\"><svg class=\"ds-dimension-line ds-dimension-horizontal\" viewBox=\"0 0 62 24\" width=\"62\" height=\"24\" aria-hidden=\"true\"><path class=\"ds-dimension-stroke\" d=\"M2 12H60M2 6V18M60 6V18\" fill=\"none\" stroke=\"currentColor\"/></svg><strong class=\"ds-measure-value\">16 pt</strong></span></button></div><button class=\"ds-measure ds-measure-vertical\" aria-pressed=\"false\" aria-label=\"Bottom padding, 0 points\"><span><svg class=\"ds-dimension-line ds-dimension-vertical\" viewBox=\"0 0 16 44\" width=\"16\" height=\"44\" aria-hidden=\"true\"><path class=\"ds-dimension-stroke\" d=\"M8 2V42M2 2H14M2 42H14\" fill=\"none\" stroke=\"currentColor\"/></svg></span><span class=\"ds-measure-label\">Bottom<strong class=\"ds-measure-value\">0 pt</strong></span></button><p class=\"ds-frame-size\">Frame · 180 × 44 pt</p><p class=\"ds-padding-caption\">Included in note</p><p class=\"ds-padding-context\">Left padding: 16 pt (measured)</p></section>",
      "css": ".ds-padding-bed{padding:16px;background:#000;color:#fff;border-radius:24px;font-family:-apple-system,BlinkMacSystemFont,system-ui,sans-serif}.ds-measure{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:0;background:transparent;border:0;border-radius:0;color:#ff3b30;font:400 12px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;cursor:pointer}.ds-measure-vertical{gap:8px;margin:0 auto}.ds-measure-label{text-align:left}.ds-measure-value{display:block;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}.ds-measure-vertical .ds-measure-value{margin-top:2px}.ds-measure-horizontal{flex-direction:column;gap:2px;width:62px;flex-shrink:0}.ds-horizontal-span{position:relative;display:flex;align-items:center;justify-content:center;width:62px;height:24px}.ds-horizontal-span .ds-measure-value{position:absolute;background:#000;padding:0 4px}.ds-dimension-line{display:block;overflow:visible}.ds-dimension-stroke{stroke-width:1.5}.ds-measure-selected .ds-dimension-stroke{stroke-width:3}.ds-measure-selected .ds-measure-value{color:#fff;font-weight:700}.ds-measure-row{display:flex;align-items:center;justify-content:center;gap:4px;margin:8px 0}.ds-capture-bed{display:inline-flex;padding:3px;background:rgb(255 255 255 / .12);border-radius:8px}.ds-capture-crop{display:flex;align-items:stretch;background:#fff;color:#000}.ds-capture-padding{width:16px;background:rgb(128 128 128 / .3)}.ds-capture-selected{background:rgb(255 0 0 / .4)}.ds-content-outline{border:1.5px solid red;font-size:28px;line-height:1.1}.ds-frame-size{margin:8px 0 16px;text-align:center;color:rgb(255 255 255 / .6);font-size:12px;font-variant-numeric:tabular-nums}.ds-padding-caption{margin:0 0 4px;color:rgb(255 255 255 / .6);font-size:12px}.ds-padding-context{margin:0;font-size:12px}.ds-measure:hover .ds-dimension-line{opacity:.8}.ds-measure:focus-visible{outline:2px solid #fff;outline-offset:3px}.ds-measure:active{opacity:.7}"
